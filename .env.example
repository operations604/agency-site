# Booking goes through Windmill (https://windmill.unlimitedholdings.org).
# Production builds already call /api/r/applied/ — no Coolify env required.
#
# Local mock (default in `npm run dev`):
#   leave VITE_BOOKING_API_URL unset
# Hit live Windmill from this machine:
#   VITE_BOOKING_API_URL=https://windmill.unlimitedholdings.org/api/r/applied/

# ---------------------------------------------------------------------------
# Mock-only test hooks — no env var needed, these are URL query params:
#
#   ?mockfail=slot_taken     slot taken while the form was open
#   ?mockfail=server_error   server failure on submit
#   ?mockfail=rate_limited   too many attempts
#   ?mockfail=network        transport failure on submit
#   ?mockfail=nomeet         booking succeeds with meetUrl: null
#   ?mockfail=empty_range    nothing open in the whole window
#   ?mockfail=availability   availability request fails
